{
  "repository": "xmanatee/pub",
  "image": "ghcr.io/xmanatee/pub",
  "channel": "web",
  "allowPublicSource": true,
  "check": "check:web",
  "build": "build:web",
  "dist": "web/dist",
  "required": [
    "web/dist/index.html",
    "web/dist/sandbox/index.html",
    "web/dist/sandbox/sw.js",
    "web/dist/install.sh",
    "nginx.conf"
  ],
  "audit": ["audit"],
  "environment": {
    "VITE_CONVEX_URL": "https://silent-guanaco-514.convex.cloud",
    "VITE_SANDBOX_ORIGIN": "https://sandbox.pub.blue"
  },
  "health": [
    {
      "host": "pub.blue",
      "path": "/",
      "file": "index.html",
      "marker": "Adaptive interfaces, powered by your agent</title>"
    },
    {
      "host": "sandbox.pub.blue",
      "path": "/__canvas__/qualification",
      "file": "sandbox/index.html",
      "marker": "<title>Pub Sandbox</title>"
    },
    {
      "host": "sandbox.pub.blue",
      "path": "/sw.js",
      "file": "sandbox/sw.js",
      "marker": "Pub FS Service Worker"
    }
  ]
}
