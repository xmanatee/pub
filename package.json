{
  "name": "pub-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "convex dev --once && concurrently -r 'pnpm dev:web' 'pnpm dev:db'",
    "dev:db": "convex dev",
    "dev:web": "pnpm --filter pub-web dev",
    "build": "pnpm build:web && pnpm build:super-app && pnpm build:cli && pnpm build:relay",
    "build:cli": "pnpm --filter pub-cli build",
    "build:relay": "pnpm --filter pub-relay build",
    "build:super-app": "pnpm --filter pub-super-app build",
    "build:web": "pnpm --filter pub-web build",
    "preview": "pnpm --filter pub-web preview",
    "typecheck": "tsc --noEmit && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "lint": "pnpm lint:root && pnpm lint:web && pnpm lint:super-app",
    "lint:fix": "biome check --fix .",
    "lint:root": "biome check . && bash scripts/validate-shared.sh && node scripts/validate-repo-conventions.mjs",
    "lint:super-app": "pnpm --filter pub-super-app lint",
    "lint:web": "pnpm --filter pub-web lint",
    "format": "biome format --write .",
    "test": "pnpm test:root && pnpm test:web && pnpm test:super-app && pnpm test:cli && pnpm test:ip-compat",
    "test:watch": "pnpm --filter pub-web test:watch",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:cli": "pnpm --filter pub-cli test",
    "test:e2e:web": "E2E_SUITE=web pnpm test:e2e",
    "test:ip-compat": "pnpm --filter ip test",
    "test:root": "vitest run",
    "test:super-app": "pnpm --filter pub-super-app test",
    "test:web": "pnpm --filter pub-web test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm knip",
    "check:all": "pnpm check && pnpm build && pnpm audit && pnpm test:e2e",
    "deploy:convex": "convex deploy",
    "knip": "knip"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.93",
    "@convex-dev/rate-limiter": "^0.3.2",
    "concurrently": "^10.0.3",
    "convex": "^1.40.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/ws": "^8.5.0",
    "knip": "^6.15.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-6cpc-mj5c-m9rq"
      ]
    }
  }
}
